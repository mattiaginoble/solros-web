# Database: file SQLite locale (percorso relativo alla radice del progetto)...
DATABASE_URL="file:./prisma/dev.db"
# ...oppure Turso (libSQL in cloud), per esempio su Vercel. L'integrazione
# Turso di Vercel crea queste due variabili da sola.
# TURSO_DATABASE_URL="libsql://nome-database-utente.turso.io"
# TURSO_AUTH_TOKEN="..."

# Accesso riservato: con una password impostata, il sito chiede la password a
# chi non è ancora entrato (consigliati almeno 12 caratteri). Vuota = sito aperto.
# SITE_PASSWORD=""

# Aggiornamento pianificato del catalogo «Negozi» (IKEA): Vercel chiama
# /api/cron/store-sync con questo segreto. Vuoto = route chiusa.
# CRON_SECRET=""

# Riconoscimento automatico delle planimetrie:
#   "local"  -> analizzatore raster nel browser (predefinito, nessuna chiave)
#   "claude" -> analisi con Claude vision (richiede ANTHROPIC_API_KEY)
FLOORPLAN_ANALYZER="local"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# Limiti alle analisi con Claude (ognuna è una chiamata a pagamento):
# FLOORPLAN_ANALYZER_USER_LIMIT=10    # analisi all'ora per utente
# FLOORPLAN_ANALYZER_HOURLY_LIMIT=60  # analisi all'ora in totale
