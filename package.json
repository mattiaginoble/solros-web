{
  "name": "solros-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "NEXT_PUBLIC_STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "setup": "prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dotenv": "^18.0.9",
    "immer": "^11.2.9",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "konva": "^10.9.1",
    "nanoid": "^5.1.16",
    "next": "16.4.5",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.394",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.2",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.0.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
